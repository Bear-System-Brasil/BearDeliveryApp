# API Configuration
# Backend API URL - Replace with your backend endpoint
NEXT_PUBLIC_API_URL=https://bearsystem.tech

# Application URL
# URL where the frontend is hosted (for development use localhost)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Analytics and Monitoring
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_analytics_id

# Optional: Third-party Services
# Add your API keys for external services here

# Sentry (monitoramento de erros)
# DSN e publico por natureza (vai pro navegador). Sem ele o SDK fica desligado.
NEXT_PUBLIC_SENTRY_DSN=
# Usados so no build, para subir os source maps. SENTRY_AUTH_TOKEN e segredo:
# nunca com prefixo NEXT_PUBLIC_.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
